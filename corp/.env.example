# Opcional — na primeira abertura do app/portal, o wizard cria o owner. Use para bootstrap automatizado (CI/MDM).
KEEPMIND_CORP_OWNER_EMAIL=
KEEPMIND_CORP_OWNER_PASSWORD=
KEEPMIND_CORP_OIDC_ISSUER=
KEEPMIND_CORP_OIDC_CLIENT_ID=
KEEPMIND_CORP_OIDC_CLIENT_SECRET=
KEEPMIND_CORP_OIDC_REDIRECT_URI=http://127.0.0.1:8787/api/oidc/callback
KEEPMIND_CORP_OIDC_ADMIN_GROUP=keepmind-admins

# Servidor/VPS compartilhado: veja deploy/corp/.env.example e docs/CORP-SERVER.md
# KEEPMIND_CORP_MODE=server
# KEEPMIND_CORP_PUBLIC_URL=https://brain.empresa.com
# KEEPMIND_CORP_EMAIL_DOMAINS=empresa.com
# KEEPMIND_CORP_SETUP_TOKEN=<openssl rand -hex 32>
