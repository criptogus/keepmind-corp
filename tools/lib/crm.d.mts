import type { ContinuityAdapter } from './continuity.mjs'
export type CrmActor = 'human' | 'agent' | 'connector'
export interface Contact { id:string; kind:'person'|'company'; name:string; email:string; phone:string; companyId:string; role:string; notes:string; tags:string[]; ownerId:string; contactEveryDays:number; outreachAllowed:boolean; archivedAt:string; createdAt:string; updatedAt:string }
export interface Interaction { id:string; contactId:string; opportunityId:string; channel:'note'|'email'|'whatsapp'|'meeting'|'call'|'telegram'; direction:'inbound'|'outbound'|'internal'; body:string; occurredAt:string; source:{path?:string;externalId?:string;url?:string}; createdAt:string }
export interface Commitment { id:string; contactId:string; opportunityId:string; title:string; dueAt:string; waitingOn:'me'|'them'; status:'open'|'done'|'cancelled'; ownerId:string; sourceId:string; createdAt:string; updatedAt:string }
export interface Opportunity { id:string; contactId:string; companyId:string; title:string; stage:'lead'|'qualified'|'proposal'|'negotiation'|'won'|'lost'; value:number; currency:string; ownerId:string; nextStep:string; nextStepAt:string; createdAt:string; updatedAt:string }
export interface Draft { id:string; contactId:string; commitmentId:string; opportunityId:string; channel:'email'|'whatsapp'; subject:string; body:string; status:'draft'|'sending'|'sent'|'failed'|'unknown'|'cancelled'; autoPrepared:boolean; receipt?:string; error?:string; sentAt?:string; createdAt:string; updatedAt:string }
export interface CrmSettings { commercialEnabled:boolean; autoPrepare:boolean; allowAutomaticSend:boolean; syncConnectedChannels:boolean; followUpDays:number; dailySendLimit:number }
export interface CrmSnapshot { schemaVersion:1; revision:number; space:string; contacts:Contact[]; interactions:Interaction[]; commitments:Commitment[]; opportunities:Opportunity[]; drafts:Draft[]; settings:CrmSettings; insights:Array<{type:string;contactId?:string;commitmentId?:string;opportunityId?:string;text:string}>; duplicates:Array<{contactIds:string[];reason:string}>; metrics:Record<string,unknown>; merges:Array<Record<string,unknown>>; lastResult?:Record<string,unknown> }
export type CrmAction = 'snapshot'|'context'|'create_contact'|'update_contact'|'record_interaction'|'create_commitment'|'update_commitment'|'create_opportunity'|'update_opportunity'|'prepare_draft'|'update_draft'|'begin_delivery'|'complete_delivery'|'settings'|'merge_contacts'|'undo_merge'|'capture'|'import_legacy'|'review'
export class CrmService { constructor(adapter:ContinuityAdapter); dispatch(action:'context',args:{contactId:string;maxBytes?:number},actor?:CrmActor):{contactId:string;revision:number;space:string;text:string}; dispatch(action:CrmAction,args?:Record<string,unknown>,actor?:CrmActor):CrmSnapshot }
